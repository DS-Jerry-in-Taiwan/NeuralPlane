# ==============================================================================
# NeuralPlane — 環境變數範本 (.env 格式)
#
# 使用方式：
#   cp env.example .env
#   填入你的 secret 後直接執行 CLI（不需 source）
# ==============================================================================

# ---------------------------------------------------------------------------
# 1. LLM Provider（Phase 1C — OpenAI 相容）
# ---------------------------------------------------------------------------
# 要使用真實 LLM API，執行時加 --provider openai。
# 使用 --provider static 則不需要設這些。
#
# 支援兩種模式：
#   A) 直連 OpenAI → LLM_BASE_URL=https://api.openai.com/v1, LLM_API_KEY=sk-...
#   B) 自架 LiteLLM proxy（推薦）→ LLM_BASE_URL=http://你的主機:4000/v1
#      litellm proxy 通常不驗證 key，LLM_API_KEY 隨便填一個非空值即可
#      LLM_MODEL 填 proxy 上設定的模型名稱（如 gpt-4o, claude-3-opus, etc.）

# API key（自架 LiteLLM proxy 時隨便填一個非空值）
LLM_API_KEY=

# 模型名稱（LiteLLM proxy 上設定的 model ID）
LLM_MODEL=gpt-4o

# API base URL
# 直連 OpenAI → https://api.openai.com/v1
# 自架 LiteLLM → http://你的主機:4000/v1
LLM_BASE_URL=https://api.openai.com/v1

# 取樣溫度 (0.0 ~ 2.0)
LLM_TEMPERATURE=0.3

# 每次回應最大 token 數
LLM_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# 2. Plane API（Phase 2 以後 — live write 時需要）
# ---------------------------------------------------------------------------
# 取消註解並填入你的值。

# Plane API token
#PLANE_API_KEY=

# Plane API base URL
#PLANE_BASE_URL=https://api.plane.so

# 你的 workspace 名稱
#PLANE_WORKSPACE_SLUG=

# 目標 project UUID
#PLANE_PROJECT_ID=

# 新 issue 的預設 state UUID（可透過 GET /api/v1/workspaces/{slug}/projects/{id}/states/ 取得）
#PLANE_DEFAULT_STATE_ID=
